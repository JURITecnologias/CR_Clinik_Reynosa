# Local Docker Compose overrides. Copy to .env and fill in the values you need.
# This file is safe to commit; .env is ignored.

# Host port exposed by the app container.
CLINIK_HTTP_PORT=8080

# Laravel APP_KEY (base64:...). Leave empty to generate a random one per container start.
CLINIK_APP_KEY=

# MySQL credentials for the local database container.
CLINIK_DB_PASSWORD=clinik_local_only
CLINIK_DB_ROOT_PASSWORD=clinik_root_local_only

# Base64 of the prescription signing private key (storage/app/keys/private.pem), single line.
# Generate it with:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("backend/api-consulmdregister/storage/app/keys/private.pem"))
#   Linux/macOS: base64 -w0 backend/api-consulmdregister/storage/app/keys/private.pem
CLINIK_RECETA_KEY_B64=
